+# ======================================================================
+# Per-region KV head counts (layers with different KV heads, e.g. Gemma 4)
+# ======================================================================
+
+
+@pytest.mark.parametrize(
+    ("local_tp", "remote_tp", "local_heads", "remote_heads", "expected"),
+    [
+        # Gemma 4 sliding layers, 16 KV heads, P_TP=4 -> D_TP=8: 2-way split.
+        (8, 4, 2, 4, [0, 2, 0, 2, 0, 2, 0, 2]),
+        # Gemma 4 global layers, 4 KV heads, P_TP=4 -> D_TP=8: replicated on D,
+        # so every rank reads its source rank's single head whole.
+        (8, 4, 1, 1, [0] * 8),
+        # 4 KV heads, P_TP=2 (2 heads/rank) -> D_TP=8 (replicated, 1 head/rank).
+        (8, 2, 1, 2, [0, 0, 1, 1, 0, 0, 1, 1]),
+        # Plain GQA, 8 KV heads, P_TP=1 -> D_TP=4.
+        (4, 1, 2, 8, [0, 2, 4, 6]),
+        # Equal TP is always a whole-block read.
+        (4, 4, 4, 4, [0, 0, 0, 0]),
+    ],
+)
+def test_compute_region_head_offset(
+    local_tp, remote_tp, local_heads, remote_heads, expected
+):
+    offsets = [
+        compute_region_head_offset(
+            local_tp_rank=rank,
+            local_tp_size=local_tp,
+            remote_tp_size=remote_tp,
+            source_rank=rank * remote_tp // local_tp,
+            local_heads=local_heads,
+            remote_heads=remote_heads,
+        )
+        for rank in range(local_tp)
+    ]
+    assert offsets == expected
+
+
+def test_compute_region_head_offset_rejects_unmappable():
+    with pytest.raises(ValueError, match="not a multiple"):
+        compute_region_head_offset(0, 4, 2, 0, local_heads=2, remote_heads=3)
+    with pytest.raises(ValueError, match="D_TP >= P_TP"):
+        compute_region_head_offset(0, 2, 4, 0, local_heads=2, remote_heads=1)
+    # Wrong source rank: rank 3 of 4 needs head 3, rank 0 of P_TP=2 holds 0-1.
+    with pytest.raises(ValueError, match="needs KV heads"):
+        compute_region_head_offset(3, 4, 2, 0, local_heads=1, remote_heads=2)
+
+
+_GEMMA4_SLIDING_LEN = 2 * 1024  # 2 sliding heads per D rank
+_GEMMA4_GLOBAL_LEN = 1 * 2048  # 1 global head per D rank (head_dim 512)
