+def compute_region_head_offset(
+    local_tp_rank: int,
+    local_tp_size: int,
+    remote_tp_size: int,
+    source_rank: int,
+    local_heads: int,
+    remote_heads: int,
+) -> int:
+    """Head offset this rank reads at inside one remote region's block (D_TP >= P_TP).
+
+    ``local_heads`` / ``remote_heads`` are the physical KV heads per rank that
+    *this region* holds on each side (``AttentionSpec.num_kv_heads``). They can
+    differ between regions of one model: Gemma 4 has 16 KV heads on its
+    sliding-window layers but 4 on its global layers, so at P_TP=4 -> D_TP=8 a
+    sliding region is split 2-way while a global region (1 head on both sides,
+    replicated on D) must be read whole.
+
+    Returns the offset, in heads, from the start of the remote block; the read
+    then covers ``local_heads`` heads. Raises ``ValueError`` when the heads this
+    rank needs are not contiguous inside ``source_rank``'s block.
+    """
+    if local_tp_size < remote_tp_size:
+        raise ValueError("compute_region_head_offset handles D_TP >= P_TP only")
+    if local_heads <= 0 or remote_heads <= 0:
+        raise ValueError(
+            f"KV head counts must be positive: local={local_heads}, "
+            f"remote={remote_heads}"
+        )
+    if local_heads == remote_heads:
+        # Same per-rank heads on both sides (equal TP, or the region is
+        # replicated on D): read the whole remote block.
+        return 0
+    if remote_heads % local_heads != 0:
+        raise ValueError(
+            f"Remote KV heads per rank ({remote_heads}) is not a multiple of "
+            f"local KV heads per rank ({local_heads})."
+        )
+    # remote_heads > local_heads >= 1, so P is not replicated for this region and
+    # the region's total head count is exact.
+    total_heads = remote_heads * remote_tp_size
+    local_first_head = local_tp_rank * total_heads // local_tp_size
+    remote_first_head = source_rank * remote_heads
+    offset = local_first_head - remote_first_head
+    if offset < 0 or offset + local_heads > remote_heads:
+        raise ValueError(
+            f"Local rank {local_tp_rank} needs KV heads "
+            f"[{local_first_head}, {local_first_head + local_heads}) but source "
+            f"rank {source_rank} holds [{remote_first_head}, "
+            f"{remote_first_head + remote_heads})."
+        )
+    return offset
