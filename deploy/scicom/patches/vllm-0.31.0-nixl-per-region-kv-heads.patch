+def _make_per_region_worker(
+    tp_rank: int,
+    tp_size: int,
+    remote_tp_size: int,
+    local_region_heads: list[int],
+    block_lens: list[int],
+):
+    worker = object.__new__(NixlConnectorWorker)
+    worker.use_mla = False
+    worker._group_spec_types = (FullAttentionSpec,)
+    worker._transfer_layer_region_indices = ()
+    worker.block_len_per_layer = list(block_lens)
+    worker._region_is_mla = [False] * len(block_lens)
+    worker.region_kv_heads = list(local_region_heads)
+    worker.transfer_topo = SimpleNamespace(
+        tp_rank=tp_rank,
+        tp_size=tp_size,
+        total_num_kv_heads=16,
+        local_physical_heads=max(1, 16 // tp_size),
+        get_engine_info=lambda *_: SimpleNamespace(remote_tp_size=remote_tp_size),
+    )
+    return worker
+
+
+def _gemma4_remote_meta(region_kv_heads, block_lens):
