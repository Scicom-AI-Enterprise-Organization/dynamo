+@pytest.mark.parametrize("tp_rank", range(8))
+def test_build_fa_remote_per_region_heads_gemma4(tp_rank):
+    """P_TP=4 -> D_TP=8 with a 16-head sliding region and a 4-head global one.
+
+    The sliding region reads this rank's 2-head half of the source block; the
+    global region reads the source rank's whole single-head block.
+    """
+    worker = _make_per_region_worker(
+        tp_rank,
+        tp_size=8,
+        remote_tp_size=4,
+        local_region_heads=[2, 1],
+        block_lens=[_GEMMA4_SLIDING_LEN, _GEMMA4_GLOBAL_LEN],
+    )
+    remote_lens = [2 * _GEMMA4_SLIDING_LEN, _GEMMA4_GLOBAL_LEN]
+    meta = _gemma4_remote_meta([4, 1], remote_lens)
+    plan = _compute_mapping(tp_rank=tp_rank, tp_size=8, remote_tp_size=4, num_kv_heads=16)
+
+    descs = worker._build_fa_remote(plan, meta, block_size_ratio=1).tolist()
+
+    sliding_offset = (tp_rank % 2) * _GEMMA4_SLIDING_LEN
+    # 0.31.0 writes one [addr, len, device] descriptor per block (main uses strided ones).
+    assert descs == [
+        [0x10000 + sliding_offset + k * remote_lens[0], _GEMMA4_SLIDING_LEN, 0]
+        for k in range(4)
+    ] + [[0x90000 + k * remote_lens[1], _GEMMA4_GLOBAL_LEN, 0] for k in range(4)]
+
+
+def test_build_fa_remote_legacy_peer_keeps_model_wide_split():
+    """A peer without region_kv_heads keeps the model-wide behaviour."""
+    worker = _make_per_region_worker(
+        1, 8, 4, [2, 1], [_GEMMA4_SLIDING_LEN, _GEMMA4_GLOBAL_LEN]
+    )
+    meta = _gemma4_remote_meta(None, [2 * _GEMMA4_SLIDING_LEN, _GEMMA4_GLOBAL_LEN])
+    plan = _compute_mapping(tp_rank=1, tp_size=8, remote_tp_size=4, num_kv_heads=16)
+    descs = worker._build_fa_remote(plan, meta, block_size_ratio=1).tolist()
+    # Both regions get the model-wide 2-way offset (wrong for the global one,
+    # which is why the handshake validation rejects this pairing).
+    assert descs[1][0] == 0x90000 + _GEMMA4_GLOBAL_LEN
+
+
+def test_region_head_offsets_rejects_mixed_hma_region():
+    worker = _make_per_region_worker(0, 8, 4, [-1], [_GEMMA4_SLIDING_LEN])
+    meta = _gemma4_remote_meta([-1], [2 * _GEMMA4_SLIDING_LEN])
+    meta.kv_caches_base_addr = [0x10000]
+    with pytest.raises(NotImplementedError, match="disable-hybrid-kv-cache-manager"):
+        worker._region_head_offsets(meta, remote_tp_size=4)
+
+
+def test_region_head_offsets_rejects_p_gt_d_with_mixed_heads():
+    # P_TP=8 -> D_TP=4: global region has 1 head per rank on both sides, which
+    # differs from the model-wide 4 -> 2 heads per rank.
+    worker = _make_per_region_worker(0, 4, 8, [4, 1], [4096, 2048])
+    meta = _gemma4_remote_meta([2, 1], [2048, 2048])
+    with pytest.raises(NotImplementedError, match="prefill TP > decode TP"):
+        worker._region_head_offsets(meta, remote_tp_size=8)
+
+
+def test_region_head_offsets_uniform_heads_matches_model_wide():
+    """For a uniform model the per-region offsets equal rank_offset_factor."""
+    for tp_rank in range(4):
+        worker = _make_per_region_worker(tp_rank, 4, 2, [4, 4], [4096, 4096])
+        meta = _gemma4_remote_meta([8, 8], [8192, 8192])
+        plan = _compute_mapping(
+            tp_rank=tp_rank, tp_size=4, remote_tp_size=2, num_kv_heads=16
+        )
+        offsets = worker._region_head_offsets(meta, remote_tp_size=2)
+        assert offsets == [plan.rank_offset_factor * 4] * 2
