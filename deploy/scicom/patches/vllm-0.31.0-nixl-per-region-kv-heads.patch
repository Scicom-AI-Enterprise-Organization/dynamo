+            connector.connector_worker = FakeNixlConnectorWorker(
+                vllm_config, connector.engine_id, hand_shake_latency=0
+            )
+            worker = connector.connector_worker
+
+            worker.transfer_topo.total_num_kv_heads = 16
+            worker.transfer_topo.local_physical_heads = 2
+            worker.kv_cache_layout = "LBHNC"
+
+            sliding_len = 2 * 256 * worker.block_size  # 2 heads/rank
+            global_len = 1 * 512 * worker.block_size  # 1 head/rank
+            worker.block_len_per_layer = [sliding_len, global_len]
+            worker.block_stride_per_layer = [sliding_len, global_len]
+            worker._region_is_mla = [False, False]
+            worker.region_kv_heads = [2, 1]
+            worker.region_num_blocks = [1, 1]
+            worker.region_group_ids = [0, 0]
+            worker.num_regions = 2
+            worker.num_blocks = 1
