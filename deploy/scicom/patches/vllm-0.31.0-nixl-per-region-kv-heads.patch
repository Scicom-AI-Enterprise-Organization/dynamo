+        agent_metadata=b"",
+        kv_caches_base_addr=[0x10000, 0x90000],
+        device_id=0,
+        num_blocks=4,
+        block_lens=list(block_lens),
+        block_strides=list(block_lens),
+        kv_cache_layout="LBHNC",
+        block_size=16,
+        ssm_sizes=(0, 0),
+        attn_backend_name="FLASH_ATTN",
+        physical_blocks_per_logical_kv_block=1,
+        region_kv_heads=region_kv_heads,
+    )
