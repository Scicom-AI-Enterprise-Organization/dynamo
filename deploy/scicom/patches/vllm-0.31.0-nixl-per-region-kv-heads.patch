+        """Layers with different KV head counts under D_TP > P_TP (Gemma 4).
+
+        Model-wide 16 KV heads, but the second region (a global layer) has only
+        4. At P_TP=4 -> D_TP=8 the sliding region halves its block while the
+        global region keeps one head per rank on both sides. With per-region
+        heads advertised the handshake validates; a peer that does not
+        advertise them falls back to the model-wide split and is rejected.
+        """
+        block_size = 16  # 0.31.0 tests have no maybe_update_block_size (XPU-only 64)
