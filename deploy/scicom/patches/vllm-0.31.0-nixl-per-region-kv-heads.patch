+    def _region_head_offsets(
+        self, nixl_agent_meta: NixlAgentMetadata, remote_tp_size: int
+    ) -> list[int | None] | None:
+        """Per-region head offsets for hetero TP, in remote region order.
+
+        Uses each region's own KV heads per rank (advertised by both sides)
+        instead of the model-wide ``total_num_kv_heads``, so layers with fewer
+        KV heads (e.g. Gemma 4 global layers) are split by their own count.
+        Returns None to keep the model-wide behaviour: equal TP, MLA, or a peer
+        that does not advertise per-region heads. An entry is None for a region
+        that is not head-sharded (SSM, scratch, MLA).
+        """
+        assert self.transfer_topo is not None
+        topo = self.transfer_topo
+        remote_heads = nixl_agent_meta.region_kv_heads
+        local_region_heads = getattr(self, "region_kv_heads", None)
+        if (
+            remote_heads is None
+            or self.use_mla
+            or topo.tp_size == remote_tp_size
+            or not local_region_heads
+            or len(local_region_heads) != len(self.block_len_per_layer)
+        ):
+            return None
+        local_regions = list(
+            self._transfer_layer_region_indices or range(len(self.block_len_per_layer))
+        )
+        if len(remote_heads) != len(local_regions):
+            return None  # region-count mismatch is reported by the caller
+
+        model_local = topo.local_physical_heads
+        model_remote = max(1, topo.total_num_kv_heads // remote_tp_size)
+        source_rank = topo.tp_rank * remote_tp_size // topo.tp_size
+        offsets: list[int | None] = []
+        for i, region_idx in enumerate(local_regions):
+            lh, rh = self.region_kv_heads[region_idx], remote_heads[i]
+            if lh == 0 and rh == 0:
+                offsets.append(None)
+                continue
+            if lh < 0 or rh < 0:
+                raise NotImplementedError(
+                    "NIXL heterogeneous TP cannot re-shard a KV region shared by "
+                    "layers with different KV head counts (hybrid KV cache "
+                    f"manager, region {region_idx}). Use matching TP sizes, or "
+                    "start both prefill and decode with "
+                    "--disable-hybrid-kv-cache-manager."
+                )
+            if lh == 0 or rh == 0:
+                offsets.append(None)  # layer-type mismatch, caller reports it
+                continue
+            if topo.tp_size < remote_tp_size:
+                if (lh, rh) != (model_local, model_remote):
+                    raise NotImplementedError(
+                        "NIXL heterogeneous TP with prefill TP > decode TP does "
+                        "not support layers with different KV head counts "
+                        f"(region {region_idx}: local {lh} vs model {model_local}, "
+                        f"remote {rh} vs model {model_remote} heads per rank). "
+                        "Use decode TP >= prefill TP, or matching TP sizes."
+                    )
+                offsets.append(None)
+                continue
+            try:
+                offsets.append(
+                    compute_region_head_offset(
+                        local_tp_rank=topo.tp_rank,
+                        local_tp_size=topo.tp_size,
+                        remote_tp_size=remote_tp_size,
+                        source_rank=source_rank,
+                        local_heads=lh,
+                        remote_heads=rh,
+                    )
+                )
+            except ValueError as e:
+                raise RuntimeError(
+                    f"NIXL heterogeneous TP cannot map KV region {region_idx} "
+                    f"(local TP {topo.tp_size}, remote TP {remote_tp_size}): {e}"
+                ) from e
+        return offsets
