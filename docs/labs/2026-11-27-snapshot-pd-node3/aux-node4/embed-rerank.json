    {
      "apiVersion": "v1",
      "data": {
        "fork.patch": "commit 5cca3d347116312b3dd0dc53ea3862c39932a7a7\nAuthor: ariffnazhan-scicom <ariff.asri@scicom.com.my>\nDate:   Tue Oct 13 14:01:39 2026 +0800\n\n    feat(models): support jina-reranker-v3.5 interleaved sliding-window layers\n    \n    jina-reranker-v3.5 is jina-reranker-v3 with 16 of its 28 Qwen3 layers\n    restricted to a 1024-token sliding window (config.layer_types). Qwen2Model\n    built every layer as full attention, so the engine loaded the model and\n    returned scores that drift from the transformers reference once a prompt\n    is longer than the window.\n    \n    Qwen2Model now passes per_layer_sliding_window to the layers that\n    layer_types marks as sliding_attention. Decoder layer types that do not\n    take the argument raise instead of silently ignoring the window.\n    \n    Measured on one H20 against model.rerank() from transformers, nine\n    rerank requests of 346 to 25,794 prompt tokens:\n    - v0.30.0: max score difference 0.072, top document differs in 1 of 9\n    - this change: max score difference 0.003, top document same in 9 of 9\n\ndiff --git a/vllm/model_executor/models/qwen2.py b/vllm/model_executor/models/qwen2.py\nindex 7513936ebb..43f467eb02 100644\n--- a/vllm/model_executor/models/qwen2.py\n+++ b/vllm/model_executor/models/qwen2.py\n@@ -25,6 +25,7 @@\n # limitations under the License.\n \"\"\"Inference-only Qwen2 model compatible with HuggingFace weights.\"\"\"\n \n+import inspect\n from collections.abc import Iterable\n from itertools import islice\n from typing import Any\n@@ -346,16 +347,32 @@ class Qwen2Model(nn.Module, EagleModelMixin):\n         cache_config = vllm_config.cache_config\n         quant_config = vllm_config.quant_config\n \n-        # TODO (@robertgshaw2): see if this can be moved out\n-        if len(set(getattr(config, \"layer_types\", []))) > 1:\n-            assert config.max_window_layers == config.num_hidden_layers, (\n-                \"Sliding window for some but all layers is not supported. \"\n-                \"This model uses sliding window but `max_window_layers` = {} \"\n-                \"is less than `num_hidden_layers` = {}. Please open an issue \"\n-                \"to discuss this feature.\".format(\n-                    config.max_window_layers,\n-                    config.num_hidden_layers,\n-                )\n+        # Models that interleave sliding-window and full-attention layers list the\n+        # kind of each layer in `layer_types` (e.g. jinaai/jina-reranker-v3.5).\n+        layer_types = getattr(config, \"layer_types\", None) or []\n+        interleaved = len(set(layer_types)) > 1\n+        if interleaved and (\n+            \"per_layer_sliding_window\"\n+            not in inspect.signature(decoder_layer_type).parameters\n+        ):\n+            raise ValueError(\n+                f\"{decoder_layer_type.__name__} does not support interleaved \"\n+                \"sliding-window and full-attention layers (`layer_types`).\"\n+            )\n+\n+        def make_layer(prefix: str) -> nn.Module:\n+            kwargs = {}\n+            if (\n+                interleaved\n+                and layer_types[extract_layer_index(prefix)] == \"sliding_attention\"\n+            ):\n+                kwargs[\"per_layer_sliding_window\"] = config.sliding_window\n+            return decoder_layer_type(\n+                config=config,\n+                cache_config=cache_config,\n+                quant_config=quant_config,\n+                prefix=prefix,\n+                **kwargs,\n             )\n \n         self.config = config\n@@ -378,12 +395,7 @@ class Qwen2Model(nn.Module, EagleModelMixin):\n \n         self.start_layer, self.end_layer, self.layers = make_layers(\n             config.num_hidden_layers,\n-            lambda prefix: decoder_layer_type(\n-                config=config,\n-                cache_config=cache_config,\n-                quant_config=quant_config,\n-                prefix=prefix,\n-            ),\n+            make_layer,\n             prefix=f\"{prefix}.layers\",\n         )\n \n",
        "start.sh": "#!/bin/sh\n# Applies the fork commit to the image's stock vLLM 0.31.0, then starts the engine with the container's args.\n# Fails closed: anything but the stock file (sha before) or the fork's file (sha after) stops the container.\nset -eu\nSITE=/usr/local/lib/python3.12/dist-packages\nF=$SITE/vllm/model_executor/models/qwen2.py\nSTOCK=6684104ba6dc40325bb1f6e632ec90633fa83a7b95883bb2181e9dc0008c3e21\nFORK=f6abd358c816809e9d1ac44a6361c1f47478b247dccc740c11c53d594db93cec\nhave=$(sha256sum \"$F\" | cut -d' ' -f1)\nif [ \"$have\" = \"$STOCK\" ]; then\n  patch -p1 -d \"$SITE\" < /fork/fork.patch\n  have=$(sha256sum \"$F\" | cut -d' ' -f1)\nfi\nif [ \"$have\" != \"$FORK\" ]; then\n  echo \"qwen2.py sha256 $have is neither stock v0.31.0 nor the fork, refusing to start\" >&2\n  exit 1\nfi\necho \"vllm $(python3 -c 'import vllm; print(vllm.__version__)') + fork commit 5cca3d3471 (vllm-jina-reranker PR #1), qwen2.py sha256 $have\"\nnvidia-smi --query-gpu=index,uuid,memory.used,memory.total --format=csv || true\nexec vllm serve \"$@\"\n"
      },
