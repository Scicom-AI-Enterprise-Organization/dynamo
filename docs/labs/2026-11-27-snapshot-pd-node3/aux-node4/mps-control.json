{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "default",
        "namespace": "mps-control",
        "annotations": null
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "DaemonSet",
      "metadata": {
        "annotations": {
          "deprecated.daemonset.template.generation": "1"
        },
        "labels": {
          "app": "mps-control"
        },
        "name": "mps-control",
        "namespace": "mps-control"
      },
      "spec": {
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "mps-control"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "mps-control"
            }
          },
          "spec": {
            "containers": [
              {
                "args": [
                  "set -u\n# Supervisor: every 30 s, start any card whose control daemon is missing. A daemon that dies (OOM,\n# crash) would otherwise leave the engines on that card unable to start until this pod restarts.\nwhile true; do\n  for i in 0 1 2 3 4 5 6 7; do\n    mkdir -p /tmp/nvidia-mps/gpu$i /tmp/nvidia-mps/log$i\n    if [ -S /tmp/nvidia-mps/gpu$i/control ] \\\n       && CUDA_MPS_PIPE_DIRECTORY=/tmp/nvidia-mps/gpu$i nvidia-cuda-mps-control -q >/dev/null 2>&1; then\n      continue\n    fi\n    if CUDA_VISIBLE_DEVICES=$i \\\n       CUDA_MPS_PIPE_DIRECTORY=/tmp/nvidia-mps/gpu$i \\\n       CUDA_MPS_LOG_DIRECTORY=/tmp/nvidia-mps/log$i \\\n       nvidia-cuda-mps-control -d; then\n      echo \"$(date -Is) gpu$i: control daemon started\"\n    else\n      echo \"$(date -Is) gpu$i: FAILED to start\" >&2\n    fi\n  done\n  sleep 30\ndone\n"
                ],
                "command": [
                  "/bin/bash",
                  "-c"
                ],
                "env": [
                  {
                    "name": "NVIDIA_VISIBLE_DEVICES",
                    "value": "all"
                  },
                  {
                    "name": "NVIDIA_DRIVER_CAPABILITIES",
                    "value": "compute,utility"
                  }
                ],
                "image": "localhost/scicom/vllm-openai:0.31.0-flashinfer-0.7.3-cu130",
                "imagePullPolicy": "IfNotPresent",
                "name": "mps",
                "resources": {
                  "limits": {
                    "memory": "256Mi"
                  },
                  "requests": {
                    "cpu": "100m",
                    "memory": "64Mi"
                  }
                },
                "securityContext": {
                  "privileged": true
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File",
                "volumeMounts": [
                  {
                    "mountPath": "/tmp/nvidia-mps",
                    "name": "mps"
                  },
                  {
                    "mountPath": "/usr/bin/nvidia-cuda-mps-control",
                    "name": "mps-control"
                  },
                  {
                    "mountPath": "/usr/bin/nvidia-cuda-mps-server",
                    "name": "mps-server"
                  }
                ]
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "hostPID": true,
            "nodeSelector": {
              "kubernetes.io/hostname": "tm-ucc-hpfsset5-0001"
            },
            "restartPolicy": "Always",
            "runtimeClassName": "nvidia",
            "schedulerName": "default-scheduler",
            "securityContext": {},
            "terminationGracePeriodSeconds": 30,
            "tolerations": [
              {
                "operator": "Exists"
              }
            ],
            "volumes": [
              {
                "hostPath": {
                  "path": "/tmp/nvidia-mps",
                  "type": "DirectoryOrCreate"
                },
                "name": "mps"
              },
              {
                "hostPath": {
                  "path": "/usr/bin/nvidia-cuda-mps-control",
                  "type": "File"
                },
                "name": "mps-control"
              },
              {
                "hostPath": {
                  "path": "/usr/bin/nvidia-cuda-mps-server",
                  "type": "File"
                },
                "name": "mps-server"
              }
            ]
          }
        },
        "updateStrategy": {
          "rollingUpdate": {
            "maxSurge": 0,
            "maxUnavailable": 1
          },
          "type": "RollingUpdate"
        }
      }
    }
  ]
}
